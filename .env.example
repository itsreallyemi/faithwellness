# Supabase (Phase 2+). Leave blank to use supabase/seed-data.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 once Google sign-in is configured in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE=
# The OAuth Client ID from Google Cloud (public). With it, the Google button signs in directly so Google shows FaithWellness.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
